#!/usr/bin/env python3
"""Build an isolated Codex home from shared defaults and one role overlay."""
import datetime
import json
import os
from pathlib import Path
import re
import sys
import tempfile
import tomllib
from urllib.parse import parse_qsl, urlencode, urlsplit, urlunsplit

ROLES = ("lead", "peer", "supervisor")
SHARED = ("auth.json", "skills", "plugins", "AGENTS.md", "model-instructions.md", "hooks.json")
LOCAL_HOSTS = ("127.0.0.1", "localhost", "::1")


def sanitize_instance_id(raw: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]", "", raw or "")
    return cleaned or "default"


def merge(base, overlay):
    result = dict(base)
    for key, value in overlay.items():
        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge(result[key], value)
        else:
            result[key] = value
    return result


def value_toml(value):
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, (datetime.datetime, datetime.date, datetime.time)):
        return value.isoformat()
    if isinstance(value, list):
        return "[" + ", ".join(value_toml(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{value_toml(k)} = {value_toml(v)}" for k, v in value.items()) + " }"
    raise ValueError(f"Unsupported TOML value: {type(value).__name__}")


def render(data, path=()):
    lines = []
    if path:
        lines.append("[" + ".".join(value_toml(key) for key in path) + "]")
    for key, value in data.items():
        if not isinstance(value, dict):
            lines.append(f"{value_toml(key)} = {value_toml(value)}")
    for key, value in data.items():
        if isinstance(value, dict):
            lines.extend(("", render(value, path + (key,))))
    return "\n".join(lines)


def inject_caller_agent_id(merged: dict, agent_id: str | None, mcp_port: int | None = None) -> None:
    if not agent_id:
        return
    for server in merged.get("mcp_servers", {}).values():
        if not isinstance(server, dict):
            continue
        raw_url = server.get("url", "")
        if not isinstance(raw_url, str) or not raw_url:
            continue
        url = urlsplit(raw_url)
        if url.hostname not in LOCAL_HOSTS or url.path != "/mcp/agents":
            continue
        if mcp_port is not None and url.port != mcp_port:
            continue
        query = dict(parse_qsl(url.query))
        query["callerAgentId"] = agent_id
        server["url"] = urlunsplit(url._replace(query=urlencode(query)))


def build_merged_config(baseline: dict, overlay: dict, agent_id: str | None, mcp_port: int | None = None) -> dict:
    merged = merge(baseline, overlay)
    # Role overlay instructions take precedence over personal baseline instructions.
    if baseline.get("developer_instructions") and overlay.get("developer_instructions"):
        merged["developer_instructions"] = (
            overlay["developer_instructions"].rstrip()
            + "\n\n## Shared baseline instructions\n\n"
            + "If any baseline preference below conflicts with your SLP role above, follow your SLP role.\n\n"
            + baseline["developer_instructions"].lstrip()
        )
    inject_caller_agent_id(merged, agent_id, mcp_port=mcp_port)
    return merged


def sync_role(role: str, canonical: Path, runtime: Path, agent_id: str | None, mcp_port: int | None = None) -> Path:
    baseline = tomllib.loads((canonical / "config.toml").read_text(encoding="utf-8"))
    overlay = tomllib.loads((canonical / f"{role}.config.toml").read_text(encoding="utf-8"))
    merged = build_merged_config(baseline, overlay, agent_id=agent_id, mcp_port=mcp_port)
    text = "# Generated by codex-room-sync; edit ~/.codex/*.config.toml instead.\n" + render(merged) + "\n"
    if tomllib.loads(text) != merged:
        raise ValueError("Generated config does not match merged configuration")

    # Validate every destination before changing any runtime content.
    for name in SHARED:
        path = runtime / name
        if path.exists() and not path.is_symlink():
            raise SystemExit(f"Refusing to replace non-symlink: {path}")

    runtime.mkdir(parents=True, exist_ok=True, mode=0o700)
    for name in SHARED:
        target = canonical / name
        path = runtime / name
        if not target.exists():
            continue
        if path.is_symlink() and path.readlink() == target:
            continue
        if path.is_symlink():
            path.unlink()
        path.symlink_to(target, target_is_directory=target.is_dir())

    fd, temporary = tempfile.mkstemp(prefix="config.", suffix=".toml", dir=runtime)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            stream.write(text)
        os.replace(temporary, runtime / "config.toml")
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return runtime / "config.toml"


def main():
    if len(sys.argv) not in (2, 3) or sys.argv[1] not in ROLES:
        raise SystemExit("usage: codex-room-sync <lead|peer|supervisor> [runtime_dir]")
    role = sys.argv[1]
    agent_id = os.environ.get("PASEO_AGENT_ID")
    raw_port = os.environ.get("PASEO_MCP_PORT")
    mcp_port = int(raw_port) if raw_port else None
    canonical = Path(os.environ.get("SLP_CODEX_CANONICAL", str(Path.home() / ".codex")))
    if len(sys.argv) == 3:
        runtime = Path(sys.argv[2])
    else:
        runtime = Path.home() / ".codex-runtime" / role / sanitize_instance_id(agent_id or "default")
    sync_role(role, canonical=canonical, runtime=runtime, agent_id=agent_id, mcp_port=mcp_port)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        raise SystemExit(f"codex-room-sync: {error}")
